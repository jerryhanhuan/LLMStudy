# AI Agent Demo 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置值

# =============================================================================
# LLM 配置
# =============================================================================

# LLM API 配置
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30

# =============================================================================
# 数据库配置
# =============================================================================

# 数据库类型: sqlite, mysql, postgresql
DATABASE_TYPE=sqlite

# SQLite 配置
DATABASE_URL=sqlite:///./agent_data.db

# MySQL 配置示例
# DATABASE_URL=mysql://username:password@localhost:3306/agent_db

# PostgreSQL 配置示例
# DATABASE_URL=postgresql://username:password@localhost:5432/agent_db

# 数据库连接池配置
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# 服务器配置
# =============================================================================

# 服务器主机和端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 工作进程数
SERVER_WORKERS=1

# 是否启用重载（开发模式）
SERVER_RELOAD=true

# 是否启用调试模式
SERVER_DEBUG=true

# =============================================================================
# API 配置
# =============================================================================

# API 版本
API_VERSION=v1

# API 前缀
API_PREFIX=/api/v1

# 请求大小限制（字节）
API_MAX_REQUEST_SIZE=10485760

# 速率限制
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000

# CORS 配置
API_CORS_ORIGINS=*
API_CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
API_CORS_HEADERS=*

# =============================================================================
# 安全配置
# =============================================================================

# JWT 密钥（请使用强密码）
SECURITY_SECRET_KEY=your_very_secret_key_here_please_change_this

# JWT 算法
SECURITY_ALGORITHM=HS256

# JWT 过期时间（秒）
SECURITY_ACCESS_TOKEN_EXPIRE=3600

# API 密钥（可选）
SECURITY_API_KEYS=demo_key_1:Demo Client 1,demo_key_2:Demo Client 2

# 是否启用认证
SECURITY_ENABLE_AUTH=false

# =============================================================================
# 日志配置
# =============================================================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING_LEVEL=INFO

# 日志格式
LOGGING_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level} | {name}:{function}:{line} | {message}

# 日志文件路径
LOGGING_FILE_PATH=logs/agent.log

# 日志文件大小限制（MB）
LOGGING_MAX_SIZE=10

# 日志文件保留数量
LOGGING_BACKUP_COUNT=5

# 是否启用控制台日志
LOGGING_CONSOLE=true

# 是否启用文件日志
LOGGING_FILE=true

# =============================================================================
# Agent 配置
# =============================================================================

# Agent 名称
AGENT_NAME=AI Assistant

# Agent 描述
AGENT_DESCRIPTION=A helpful AI assistant powered by LLM

# 是否启用工具
AGENT_ENABLE_TOOLS=true

# 是否启用记忆
AGENT_ENABLE_MEMORY=true

# 是否启用规划
AGENT_ENABLE_PLANNING=true

# 最大对话历史长度
AGENT_MAX_HISTORY=50

# 工具执行超时（秒）
AGENT_TOOL_TIMEOUT=30

# 任务执行超时（秒）
AGENT_TASK_TIMEOUT=300

# =============================================================================
# 记忆配置
# =============================================================================

# 记忆存储类型: memory, file, database
MEMORY_STORAGE_TYPE=memory

# 记忆数据库路径（当存储类型为database时）
MEMORY_DATABASE_PATH=memory.db

# 最大历史记录数
MEMORY_MAX_HISTORY=50

# =============================================================================
# 工具配置
# =============================================================================

# 计算器工具
TOOL_CALCULATOR_ENABLED=true

# 天气工具
TOOL_WEATHER_ENABLED=true
TOOL_WEATHER_API_KEY=your_weather_api_key
TOOL_WEATHER_API_URL=http://api.openweathermap.org/data/2.5/weather

# 邮件工具
TOOL_EMAIL_ENABLED=true
TOOL_EMAIL_SMTP_SERVER=smtp.gmail.com
TOOL_EMAIL_SMTP_PORT=587
TOOL_EMAIL_USERNAME=your_email@gmail.com
TOOL_EMAIL_PASSWORD=your_email_password
TOOL_EMAIL_USE_TLS=true

# 时间工具
TOOL_TIME_ENABLED=true

# 文件搜索工具
TOOL_FILE_SEARCH_ENABLED=true
TOOL_FILE_SEARCH_BASE_PATH=./

# =============================================================================
# 缓存配置
# =============================================================================

# 是否启用缓存
CACHE_ENABLED=true

# 缓存类型: memory, redis
CACHE_TYPE=memory

# Redis 配置（当缓存类型为redis时）
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_PASSWORD=

# 缓存过期时间（秒）
CACHE_EXPIRE_TIME=3600

# =============================================================================
# 监控配置
# =============================================================================

# 是否启用监控
MONITORING_ENABLED=true

# 监控端口
MONITORING_PORT=8001

# 健康检查间隔（秒）
MONITORING_HEALTH_CHECK_INTERVAL=30

# 性能指标收集间隔（秒）
MONITORING_METRICS_INTERVAL=60

# =============================================================================
# 开发配置
# =============================================================================

# 开发模式
DEV_MODE=true

# 是否启用热重载
DEV_HOT_RELOAD=true

# 是否启用调试工具
DEV_DEBUG_TOOLS=true

# 测试数据库URL
DEV_TEST_DATABASE_URL=sqlite:///./test_agent.db

# =============================================================================
# 插件配置
# =============================================================================

# 插件目录
PLUGIN_DIRECTORY=plugins

# 是否自动加载插件
PLUGIN_AUTO_LOAD=true

# 启用的插件列表（逗号分隔）
PLUGIN_ENABLED=

# =============================================================================
# 外部服务配置
# =============================================================================

# 第三方API配置
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_RETRY_COUNT=3
EXTERNAL_API_RETRY_DELAY=1

# Webhook 配置
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# =============================================================================
# 性能配置
# =============================================================================

# 并发限制
PERFORMANCE_MAX_CONCURRENT_REQUESTS=100

# 连接池大小
PERFORMANCE_CONNECTION_POOL_SIZE=20

# 请求超时（秒）
PERFORMANCE_REQUEST_TIMEOUT=30

# 响应超时（秒）
PERFORMANCE_RESPONSE_TIMEOUT=60

# =============================================================================
# 备份配置
# =============================================================================

# 是否启用自动备份
BACKUP_ENABLED=false

# 备份间隔（小时）
BACKUP_INTERVAL=24

# 备份保留天数
BACKUP_RETENTION_DAYS=7

# 备份目录
BACKUP_DIRECTORY=backups

# =============================================================================
# 通知配置
# =============================================================================

# 是否启用通知
NOTIFICATION_ENABLED=false

# 通知类型: email, webhook, slack
NOTIFICATION_TYPE=email

# 邮件通知配置
NOTIFICATION_EMAIL_TO=admin@example.com
NOTIFICATION_EMAIL_SUBJECT_PREFIX=[AI Agent]

# Slack 通知配置
NOTIFICATION_SLACK_WEBHOOK_URL=
NOTIFICATION_SLACK_CHANNEL=#alerts

# =============================================================================
# 实验性功能
# =============================================================================

# 是否启用实验性功能
EXPERIMENTAL_FEATURES=false

# 流式响应
EXPERIMENTAL_STREAMING=false

# 多模态支持
EXPERIMENTAL_MULTIMODAL=false

# 分布式处理
EXPERIMENTAL_DISTRIBUTED=false